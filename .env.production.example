# Production Environment Configuration
# Copy to .env.production and fill in all values
# NEVER commit this file with real secrets

# Database
POSTGRES_DB=business_analytics
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_strong_random_password_here

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_KEY=your_256_bit_base64_secret_key_here
JWT_ISSUER=BusinessAnalytics
JWT_AUDIENCE=BusinessAnalytics

# CORS - Your frontend domain
CORS_ORIGIN_0=https://app.yourdomain.com

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Docker
DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=khiwniti/ice-interview-assessment
TAG=latest

# Backup
BACKUP_RETENTION_DAYS=30

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# External backup storage (optional)
# AWS_S3_BUCKET=your-backup-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret